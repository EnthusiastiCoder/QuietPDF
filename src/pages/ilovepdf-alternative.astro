---
import Base from '../layouts/Base.astro';
import SeoHead from '../components/SeoHead.astro';

const title = 'A private iLovePDF alternative that never uploads your files | QuietPDF';
const description = 'QuietPDF does what iLovePDF does, in your browser: free, no signup, no upload, no limits. Compared with dated, cited facts.';
const sources = [
  { url: 'https://www.ilovepdf.com/pricing', label: 'iLovePDF pricing', date: '2026-11-22', note: 'the free plan lists limited document processing, batch size and file size, with no numbers given; ads are removed only on Premium; files are processed on its servers.' },
];
---

<Base title={title} description={description} canonical="/ilovepdf-alternative">
  <SeoHead slot="head" title={title} description={description} path="/ilovepdf-alternative" />
  <article class="prose">
    <h1>A private iLovePDF alternative</h1>
    <p>QuietPDF covers the everyday iLovePDF tools, but your files never leave your device: every tool runs in your browser, with no signup and no limits.</p>
    <h2>What differs</h2>
    <ul>
      <li>iLovePDF processes your files on its servers; QuietPDF never uploads them.</li>
      <li>iLovePDF's free plan is limited and shows ads; QuietPDF has no ads and no limits.</li>
      <li>QuietPDF keeps working offline once loaded.</li>
    </ul>
    <p><a href="/">See all QuietPDF tools</a> or <a href="/privacy">verify the privacy claim yourself</a>.</p>
    <h2>Sources</h2>
    <p>Facts about iLovePDF are read from its own pages. Each source shows the date it was checked.</p>
    <ul>
      {sources.map((s) => <li><a href={s.url} rel="noopener noreferrer">{s.label}</a> (checked {s.date}): {s.note}</li>)}
    </ul>
  </article>
</Base>

<style>
  .prose {
    max-width: 42rem;
    padding: var(--space-4) 0;
  }
</style>
