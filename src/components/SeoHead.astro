---
/**
 * Open Graph, Twitter card and JSON-LD for a page. Every URL is same-origin
 * (the OG image is served from /og/), so the page makes no third-party request.
 */
export interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/merge-pdf". */
  path: string;
  /** OG image file name under /og/, e.g. "merge-pdf.png". */
  image?: string;
  /** JSON-LD nodes, emitted as one @graph. */
  graph?: Record<string, unknown>[];
}

const { title, description, path, image = 'default.png', graph = [] } = Astro.props;
const url = new URL(path, Astro.site).href;
const imageUrl = new URL(`/og/${image}`, Astro.site).href;
const ld = graph.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\u003c') : '';
---

<meta property="og:type" content="website" />
<meta property="og:site_name" content="QuietPDF" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{ld && <script is:inline type="application/ld+json" set:html={ld} />}
